# Profile: URSim running in Docker on a LAN host
# (`ros2 run ur_client_library start_ursim.sh -m ur5e` or host/start_ursim.sh).
# CAMERA_IP is used by scripts/deploy.sh only; everything else is passed to the app.
# OAK4-LITE-TOF (serial 361589140); the OAK4-D R7 was 10.12.222.229.
CAMERA_IP=10.12.222.78

# LAN IP of the machine running URSim - NOT the container IP 192.168.56.101.
ROBOT_IP=10.12.222.225
UR_TYPE=ur7e   # matches the real arm; start URSim with UR_MODEL=ur7e

# Headless: the driver sends the URScript itself, no PolyScope program needed.
HEADLESS_MODE=true
# Simulation only: power on and release the brakes through the Dashboard Server.
AUTO_POWER_ON=true

# waypoints | hand | none
CONTROL_MODE=waypoints
# hand mode: mirror (camera not on the arm) | servo (camera on the tool)
FOLLOW_MODE=mirror
MOTION_LOOPS=0
MAX_JOINT_SPEED=0.5
