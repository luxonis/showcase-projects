# Profile: real UR7e on the same LAN as the camera, camera on the end effector.
# Read the "Moving to a real arm" section of the README first.
CAMERA_IP=192.168.65.172

# UR control box (PolyScope X: no Dashboard Server on 29999).
ROBOT_IP=192.168.65.242
# ur7e (PolyScope X or 5), ur5e for an e-series UR5, ur5 for a CB3 UR5.
UR_TYPE=ur7e

# Run the External Control program from the pendant (URCapX Host IP = CAMERA_IP, port 50002),
# so the operator stays in charge of starting motion.
HEADLESS_MODE=false
AUTO_POWER_ON=false
# PolyScope 5 only; PolyScope X has no Dashboard Server.
AUTO_PLAY_PROGRAM=

# Optional: factory calibration extracted with ur_calibration (path inside the app).
# KINEMATICS_PARAMS_FILE=/app/calibration/my_robot_calibration.yaml

# waypoints | hand | none
CONTROL_MODE=hand
# camera on the tool: servo
FOLLOW_MODE=servo
HAND_FOLLOW_CONFIG=/app/hand_follow_real.yaml
# Gripper (closed on a lemon, see lemon: in hand_follow_real.yaml): none | log | onrobot (Compute Box,
# set ONROBOT_IP) | tool_io (RG2 on this arm: tool digital output 0, see gripper.tool_io).
# DRY_RUN=true forces log unless GRIPPER_IN_DRY_RUN=true (grasp calibration).
GRIPPER=tool_io
# true: track and show the would-be motion, never command the arm. Set false to move.
DRY_RUN=true
MOTION_LOOPS=1
MAX_JOINT_SPEED=0.8
